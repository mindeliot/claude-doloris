{
  "name": "Claude Code + Claude Desktop | Surge Fake-IP Only",
  "description": "Apple Silicon Homebrew Claude Code (observed 2.1.323) and /Applications/Claude.app. Signature rules plus exact executable-path rules for CLI, Desktop and common Electron helpers. Allows only Surge Fake-IP 198.18.0.0/15 and loopback 127.0.0.0/8, ::1/128; denies any other outgoing endpoint. Path rules for CLI may become stale on upgrade; code-ID rules remain if signatures stay the same. Little Snitch 6 uses HTTPS remote rule-group subscriptions, not direct local .lsrules import. Check for overrides and actual traffic, including helper programs, in Network Monitor. This is not a guaranteed whole-system kill switch.",
  "rules": [
    {
      "process": "identifier.Q6L2SF6YDW/com.anthropic.claude-code",
      "action": "allow",
      "direction": "outgoing",
      "remote-addresses": "198.18.0.0/15",
      "priority": "regular",
      "notes": "Claude Code CLI — code signature. Allow Surge Fake-IP pool only when its virtual-network interception is active. Verified on this Mac; survives Homebrew version changes if signing identity is unchanged."
    },
    {
      "process": "identifier.Q6L2SF6YDW/com.anthropic.claude-code",
      "action": "allow",
      "direction": "outgoing",
      "remote-addresses": "127.0.0.0/8",
      "priority": "regular",
      "notes": "Claude Code CLI — code signature. Allow IPv4 loopback; any local service could receive this traffic. Verified on this Mac; survives Homebrew version changes if signing identity is unchanged."
    },
    {
      "process": "identifier.Q6L2SF6YDW/com.anthropic.claude-code",
      "action": "allow",
      "direction": "outgoing",
      "remote-addresses": "::1/128",
      "priority": "regular",
      "notes": "Claude Code CLI — code signature. Allow IPv6 loopback only. Verified on this Mac; survives Homebrew version changes if signing identity is unchanged."
    },
    {
      "process": "identifier.Q6L2SF6YDW/com.anthropic.claude-code",
      "action": "deny",
      "direction": "outgoing",
      "remote": "any",
      "priority": "regular",
      "notes": "Claude Code CLI — code signature. Deny any other outgoing endpoint, including direct public IPv4 and IPv6 connections. Verified on this Mac; survives Homebrew version changes if signing identity is unchanged."
    },
